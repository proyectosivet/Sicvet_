# ============================================================
# VARIABLES DE ENTORNO DE EJEMPLO - BACKEND
# ============================================================
# Copia este archivo como ".env" y ajusta los valores.
# El archivo ".env" real NO se sube al repositorio.

# Puerto donde escucha la API.
PORT=3000

# Origen(es) del frontend permitidos por CORS.
# Para varios orígenes, sepáralos con comas.
FRONTEND_URL=http://localhost:5173

# Clave para firmar los tokens JWT.
# Debe tener al menos 32 caracteres. Genera una propia y no la
# compartas. Ejemplo de generación en Node:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres
